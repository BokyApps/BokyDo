    "qrcode-generator": "^2.0.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
