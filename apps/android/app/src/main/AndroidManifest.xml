<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders are exact alarms set on the device; the user can deny this, then they may be late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Alarms don't survive a reboot: re-arm them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- To find a browser that supports Custom Tabs (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- To list installed UnifiedPush distributors (ntfy, …). -->
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <!--
      No backups: the database holds the user's tasks and the session is encrypted with a
      Keystore key that never leaves the device, so a restored copy would be useless and a
      cloud copy a leak.
    -->
    <application
        android:name=".BokyDoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BokyDo">

        <!-- nosemgrep: java.android.security.exported_activity.exported_activity (the launcher must be exported) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share target: another app's ACTION_SEND text opens the quick-add sheet prefilled
              with the shared text (sanitised, capped, never auto-saved). Only text, so files
              and streams can't arrive this way.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The end of a sign-in: the browser hands back `com.bokyapps.bokydo:/oauth2redirect?...`.
          Another app could register the same scheme; it would only see a code it can't use
          without this app's PKCE verifier, and a forged redirect fails the state check.
        -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity (the browser must reach it; input is checked against the pending sign-in) -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.bokyapps.bokydo" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderAlarmReceiver" android:exported="false" />
        <receiver android:name=".NotificationActionReceiver" android:exported="false" />

        <!--
          Quick-add tile: the system binds here, so it must be exported, but only the
          system (BIND_QUICK_SETTINGS_TILE) can. Tapping it just opens the app's sheet.
        -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity (the system must bind the tile; permission-gated, opens only) -->
        <service
            android:name=".QuickAddTileService"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/tile_quick_add"
            android:icon="@drawable/ic_notification">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Boot, clock and time-zone changes, app updates, exact-alarm permission changes: all
          protected broadcasts that only the system can send. The receiver only re-arms alarms.
        -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity (system broadcasts only; it just re-arms alarms) -->
        <receiver android:name=".SystemEventsReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          UnifiedPush: the distributor is another app, so this must be exported. Every message
          must carry our secret registration token, and push content is end-to-end encrypted to a
          key only this device has.
        -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity (UnifiedPush distributors must reach it; token-checked, payload authenticated) -->
        <receiver android:name=".UnifiedPushReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
